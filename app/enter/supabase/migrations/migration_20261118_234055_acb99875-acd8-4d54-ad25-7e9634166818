with wk as (select date_trunc('week', now() at time zone 'America/Los_Angeles')::date as mon)
insert into public.customers (name, email, phone, need_type, timeline, potential_loan_customer, hot, notes, consultant_id, meeting_scheduled, last_appointment)
select s.name, s.email, s.phone, s.need, s.tl, s.loan, s.hot, s.notes, c.id, s.ccode is not null,
  case when s.ccode is not null then ((wk.mon + s.dayoff) + s.slot) at time zone 'America/Los_Angeles' end
from seed_c s cross join wk left join public.consultants c on c.code = s.ccode;

insert into public.buying_preferences (customer_id, preferred_areas, budget, house_size_sqft, bedrooms, bathrooms, marital_status, household_size, buyer_age, credit_score, annual_income)
select cu.id, s.areas, s.budget, s.sqft, s.beds, s.baths, s.marital, s.hh, s.age, s.credit, s.income
from seed_c s join public.customers cu on cu.email = s.email;

insert into public.bookings (customer_id, consultant_id, slot_start)
select id, consultant_id, last_appointment from public.customers where meeting_scheduled;

